  url = {https://doi.org/10.1080/24735132.2025.2454731},
  urldate = {2026-06-02},
  abstract = {Denmark’s ageing population and the accompanying rise in chronic conditions present significant challenges to an already fragmented healthcare system. This study investigates how negotiation games can enable co-exploration, co-analysis, and co-design to support cross-sector collaboration in Danish Community Health Centres (CHCs). Data collected during site visits, interviews, and workshops with healthcare professionals and managers across Denmark demonstrate that negotiation games developed using the staging negotiation spaces (SNS) co-design framework foster a co-analysis process through meaningful dialogue while aligning agendas and building consensus. This iterative approach encourages double-loop learning, where empirical findings from each negotiation space inform subsequent stages. The results highlight the adaptability of various game types—configuration, ranking, and process-oriented—to suit different research and design phases, from initial exploration to collaborative analysis and development. Facilitators play a crucial role in maintaining engagement through challenges, such as struggling with digital formats. This research contributes to health design literature by showcasing how tailored negotiation games based on the SNS framework can bridge sector divides and promote co-created solutions in complex healthcare settings.},
  file = {/home/sami/Zotero/storage/EJ7KJ984/Pedersen and Dorland - 2025 - Staging situated negotiation games for (re)designing local healthcare facilities and services.pdf}
}

@inreference{PlanningPoker2026,
  title = {Planning Poker},
  booktitle = {Wikipedia},
  date = {2026-01-25T04:05:31Z},
  url = {https://en.wikipedia.org/w/index.php?title=Planning_poker&oldid=1334701199},
  urldate = {2026-03-31},
  abstract = {Planning poker, also called Scrum poker, is a consensus-based, gamified technique for estimating, mostly used for timeboxing in Agile principles. In planning poker, members of the group make estimates by playing numbered cards face-down to the table, instead of speaking them aloud. The cards are revealed, and the estimates are then discussed. By hiding the figures in this way, the group can avoid the cognitive bias of anchoring, where the first number spoken aloud sets a precedent for subsequent estimates. Planning poker is a variation of the Wideband delphi method. It is most commonly used in agile software development, in particular in Scrum and Extreme Programming. Agile software development methods recommend the use of Planning Poker for estimating the size of user stories and developing release and iteration plans.  The method was first defined and named by James Grenning in 2002 and later popularized by Mike Cohn in the book Agile Estimating and Planning, whose company trade marked the term and a digital online tool.},
  langid = {english},
  annotation = {Page Version ID: 1334701199},
  file = {/home/sami/Zotero/storage/SAZ8RY3G/index.html}
}

