@article{bakeriiiConcretisingDesignThinking2020,
  title = {Concretising {{Design Thinking}}: {{A Content Analysis}} of {{Systematic}} and {{Extended Literature Reviews}} on {{Design Thinking}} and {{Human-Centred Design}}},
  shorttitle = {Concretising {{Design Thinking}}},
  author = {Baker III, Fredrick W. and Moukhliss, Sarah},
  date = {2020},
  journaltitle = {Review of Education},
  shortjournal = {Rev. Educ.},
  volume = {8},
  number = {1},
  pages = {305--333},
  issn = {2049-6613},
  doi = {10.1002/rev3.3186},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/rev3.3186},
  urldate = {2026-05-03},
  abstract = {The purposes of this study are 1) to explore the concept of design thinking/human-centred design as expressed across the literature, using a systematic content analysis methodology, and 2) to arrive at empirically-based implications and recommendations for the instructional design field drawn from this search and analysis. Since 2000, design thinking has been highly sought after and is increasingly applied to novel challenges. Since then, it has become a force of innovation in business, and a point of contention in design—having created a reductionist perspective of design which has simultaneously become a buzzword for innovation. In the instructional design field, practitioners incorporate the methods used into new design models, and scholars frame new theories within its bounds. Through this process, the meaning and nature of the concept have become complex and clouded. This paper reports results of a systematic content analysis involving examination of 12 databases, analysing 1075 abstracts for fit and identifying 11 core articles. An extended literature review, including more than 70 non-core articles selected from the study data pool, provides a foundation for analysis of the 11 core articles. Results include analysis of the core articles for themes, industry and common citations; recommendations and implications for the instructional design field are drawn from the literature, as well as recommendations for future research.},
  langid = {english},
  keywords = {content analysis,design,design thinking,human-centred design,instructional design},
  file = {/home/sami/Zotero/storage/CQ8AQVLS/Baker III and Moukhliss - 2020 - Concretising Design Thinking A Content Analysis of Systematic and Extended Literature Reviews on De.pdf;/home/sami/Zotero/storage/QDSNQMUF/rev3.html}
}

